# -----------------------------
# Database Configuration
# -----------------------------
DB_USER=postgres                     # PostgreSQL username for connecting to the database
DB_PASSWORD=Demon                    # Password for the PostgreSQL user (keep secret!)
DB_HOST=postgres                     # Hostname or container name where PostgreSQL is running
DB_PORT=5432                          # Port number for PostgreSQL (default: 5432)
DB_NAME=srknotesapp-db               # Name of the database used by SRKNote
ENC_KEY=password                      # Default encryption key for notes (used if user doesn't provide a key)

# -----------------------------
# JWT / Authentication Settings
# -----------------------------
JWT_SECRET=prod_jwt_secret_9f8a7c6d5e4b3a2c1f0e9d8c7b6a5f4e3d2c1b0a
                                     # Secret key for signing JWT tokens (keep secure, never commit to public repo)
JWT_ALG=HS256                         # Algorithm used for JWT signing and verification
ACCESS_TOKEN_EXPIRE_MINUTES=60        # Expiration time for access tokens in minutes
